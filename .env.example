# ===== FLOSSO — maxfiy sozlamalar =====
# Bu faylni nusxalab ".env.local" deb nomlang va qiymatlarni to'ldiring.
# .env.local hech qachon GitHub'ga yuklanmaydi.

# --- Ma'lumotlar bazasi (Neon PostgreSQL) ---
# Bo'sh qoldirilsa, kompyuterda vaqtinchalik lokal baza ishlaydi (.data/pglite).
DATABASE_URL=

# --- Admin panel (/admin) ---
# Parol xeshi va sessiya kalitini olish:  npm run admin:hash -- "parolingiz"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Arizalar Telegram'ga (egasi: t.me/Flosso_uz) ---
# Bot tokeni @BotFather'dan; chat ID ni admin panel → Telegram sahifasi o'zi topadi.
# Bu ikkisini admin panelda ham saqlash mumkin; bu yerda yozilsa, ular ustun turadi.
# Bir nechta odamga yuborish: ID'larni vergul bilan yozing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Mahsulot rasmlari (Vercel Blob) ---
# Bo'sh bo'lsa, lokal rejimda rasmlar public/uploads ga saqlanadi.
BLOB_READ_WRITE_TOKEN=

# --- Google Search Console ---
# "HTML tag" usulidagi content="..." ichidagi kod (faqat kodning o'zi).
GOOGLE_SITE_VERIFICATION=

# --- Sayt manzili ---
# O'z domeningiz ulansa (masalan https://flosso.uz). Bo'sh bo'lsa Netlify manzili olinadi.
SITE_URL=

# --- Yandex Webmaster ---
# "Meta-teg" usulidagi content="..." ichidagi kod.
YANDEX_VERIFICATION=

# --- Saytdagi "Onlayn chat" uchun AI (ixtiyoriy) ---
# Bo'sh bo'lsa chat tayyor javoblar bilan ishlaydi. Kalit: console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-5-5
